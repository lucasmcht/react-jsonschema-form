  >
    <label
      className="label"
      htmlFor="root"
    >
      <span
        className="label-text font-medium"
      >
        An enum list rendered as checkboxes
      </span>
    </label>
    <div
      className="form-control"
    >
      <div
        className="flex flex-col gap-2 mt-1"
      >
        <label
          className="flex items-center cursor-pointer gap-2"
        >
